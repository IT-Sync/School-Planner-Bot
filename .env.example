# Copy to .env; never commit tokens/passwords.
BOT_TOKEN=replace-with-token-from-botfather
BOT_USERNAME=
WEBAPP_URL=https://planner.example.com

APP_ENV=production
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=planner
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_NAME=planner
AUTO_MIGRATE=false

DEFAULT_TZ=Europe/Moscow
WEEK_MODE_DEFAULT=combined
MAX_LESSONS_PER_DAY=12
MAX_EXTRAS_PER_DAY=6
HEALTH_PORT=8088
ADMIN_IDS=

# Docker publishes only the web app; PostgreSQL stays on the Compose network.
WEBAPP_BIND_HOST=127.0.0.1
WEBAPP_PORT=11002

# Local development only: set APP_ENV=development before enabling this.
# WEBAPP_DEV_USER_ID=10001
WEBAPP_AUTH_MAX_AGE=3600
REMINDER_POLL_SECONDS=30
MAX_ATTACHMENT_BYTES=5242880
